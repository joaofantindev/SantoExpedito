@model List<SantoExpedito.Models.Pet>
@{
    ViewBag.Title = "Pets";
    var clientes = ViewBag.Clientes as List<SantoExpedito.Models.Cliente> ?? new();
    var petDetalhe = ViewBag.PetDetalhe as SantoExpedito.Models.Pet;
    var searchTerm = ViewBag.SearchTerm as string ?? "";
}

<div class="page active" id="pets">
    <div class="page-header">
        <h2>Pets</h2>
        <div class="search-box">
            <i class="ti ti-search"></i>
            <input type="text" class="search-input" id="petSearch" placeholder="Buscar pet, tutor, raça..."
                   value="@searchTerm"
                   oninput="filterPets(this.value)">
        </div>
    </div>
    <div class="clientes-container">
        <div class="clientes-list-panel" style="width:380px;min-width:380px">
            <div class="card" style="border:none;box-shadow:none;margin:0">
                <table>
                    <thead><tr><th>Pet</th><th>Raça</th><th>Idade</th><th>Porte</th></tr></thead>
                    <tbody>
                        @foreach (var pet in Model)
                        {
                            var isSelected = petDetalhe?.Id == pet.Id;
                            <tr class="@(isSelected ? "active" : "")"
                                onclick="location.href='@Url.Action("Index", new { detalheId = pet.Id, search = searchTerm })'">
                                <td>@pet.Nome</td>
                                <td>@pet.Raca</td>
                                <td>@(!string.IsNullOrEmpty(pet.Idade) ? pet.Idade : "-")</td>
                                <td>@pet.Porte</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="cliente-detail" id="petDetail">
            @if (petDetalhe != null)
            {
                var p = petDetalhe;
                var tutorCliente = clientes.FirstOrDefault(cl => cl.Nome == p.Tutor && cl.PetNome == p.Nome);
                var iniciais = string.Concat(p.Nome.Split(' ').Select(pal => pal.Length > 0 ? pal[0].ToString() : "")).ToUpper();
                if (iniciais.Length > 2) iniciais = iniciais[..2];
                var banhosCalc = 0;
                if (tutorCliente != null && ViewBag.BanhosRestantesDict is Dictionary<int, int> dict)
                {
                    if (dict.TryGetValue(tutorCliente.Id, out var banhos)) banhosCalc = banhos;
                }
                var medicamentoHtml = p.Medicamento ? (!string.IsNullOrEmpty(p.MedicamentoNome) ? $"Sim - {p.MedicamentoNome}" : "Sim") : "Não";
                <div class="detail-content">
                    <div class="detail-header">
                        <div class="avatar-letter">@iniciais</div>
                        <div class="detail-header-info"><h2>@p.Nome</h2><span>@p.Raca • @p.Porte</span></div>
                    </div>
                    <div class="detail-grid">
                        <div class="detail-field"><label>Tutor</label><p>@p.Tutor</p></div>
                        @if (tutorCliente != null)
                        {
                            <div class="detail-field"><label>Telefone</label><p>@tutorCliente.Telefone</p></div>
                            <div class="detail-field"><label>Banhos Restantes</label><p style="color:var(--red);font-weight:600">@banhosCalc - Mês</p></div>
                        }
                        <div class="detail-field"><label>Idade</label><p>@(!string.IsNullOrEmpty(p.Idade) ? p.Idade : "Não informado")</p></div>
                        <div class="detail-field full"><label>Ração</label><p>@(!string.IsNullOrEmpty(p.Racao) ? p.Racao : "Não informado")</p></div>
                        <div class="detail-field"><label>Medicamento</label><p>@medicamentoHtml</p></div>
                        <div class="detail-field"><label>Última Vermifugação</label><p>@(!string.IsNullOrEmpty(p.Vermifugacao) ? p.Vermifugacao : "Não registrado")</p></div>
                        <div class="detail-field"><label>Última Antipulgas</label><p>@(!string.IsNullOrEmpty(p.Antipulgas) ? p.Antipulgas : "Não registrado")</p></div>
                        <div class="detail-field full"><label>Última Vacinação</label><p>@(!string.IsNullOrEmpty(p.Vacinacao) ? p.Vacinacao : "Não registrado")</p></div>
                    </div>
                    @if (tutorCliente != null)
                    {
                    <div class="detail-actions">
                        <a class="btn-secondary" href="@Url.Action("Index", "Clientes", new { detalheId = tutorCliente.Id })">
                            <i class="ti ti-user"></i> Visualizar Tutor
                        </a>
                    </div>
                    }
                    <div class="detail-actions">
                        <form method="post" action="@Url.Action("Excluir", "Pets")" onsubmit="return confirm('Excluir este pet e todos os seus agendamentos?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@p.Id">
                            <button type="submit" class="btn-secondary" style="color:var(--red);border-color:var(--red)">
                                <i class="ti ti-trash"></i> Excluir Pet
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="detail-empty"><i class="ti ti-paw"></i><p>Selecione um pet</p></div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
let searchTimeout;
function filterPets(value) {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
        const params = new URLSearchParams(window.location.search);
        if (value) params.set('search', value);
        else params.delete('search');
        params.delete('detalheId');
        window.location.href = '?' + params.toString();
    }, 400);
}
</script>
}
